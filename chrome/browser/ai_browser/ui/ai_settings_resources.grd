<grit latest_public_release="0" current_release="1"
      output_all_resource_defines="false">
  <outputs>
    <output filename="grit/ai_settings_resources.h" type="rc_header">
      <emit emit_type='prepend'></emit>
    </output>
    <output filename="ai_settings_resources.pak" type="data_package" />
  </outputs>
  <release seq="1">
    <includes>
      <include name="IDR_AI_SETTINGS_HTML"
               file="resources/ai_settings.html"
               type="BINDATA" />
      <include name="IDR_AI_SETTINGS_CSS"
               file="resources/ai_settings.css"
               type="BINDATA" />
      <include name="IDR_AI_SETTINGS_JS"
               file="resources/ai_settings.js"
               type="BINDATA" />
    </includes>
  </release>
</grit>
